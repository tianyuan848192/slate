{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "讲解稿（分段旁白）",
  "type": "object",
  "required": ["mode", "paragraphs"],
  "additionalProperties": false,
  "properties": {
    "mode": {"enum": ["agent", "outline", "verbatim"], "description": "agent=自己写；outline=按大纲；verbatim=逐字照念"},
    "paragraphs": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "string", "maxLength": 600}}
  }
}
