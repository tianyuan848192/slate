{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "分镜",
  "type": "object",
  "required": ["title", "ratio", "resolution", "fps", "scenes"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "maxLength": 40},
    "ratio": {"enum": ["16:9", "9:16", "1:1", "4:5"]},
    "resolution": {"enum": ["720p", "1080p"]},
    "fps": {"enum": [30, 60]},
    "bgm": {"type": ["string", "null"], "maxLength": 40},
    "caption_style": {"type": "object", "additionalProperties": false, "description": "全片统一的字幕样式，取主风格的配色和字体",
      "properties": {"bg": {"type": "string", "maxLength": 60}, "color": {"type": "string", "maxLength": 60},
                     "font": {"type": "string", "maxLength": 160}, "weight": {"type": ["string", "number"]}}},
    "scenes": {"type": "array", "minItems": 1, "maxItems": 30, "items": {
      "type": "object", "required": ["id", "title", "narration", "visual", "duration"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{2}$"},
        "title": {"type": "string", "maxLength": 20},
        "narration": {"type": "string", "maxLength": 600},
        "visual": {"type": "string", "maxLength": 400},
        "duration": {"type": "number", "minimum": 1, "maximum": 60},
        "skill": {"type": "string", "maxLength": 40},
        "images": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^i[0-9]{2}$"},
          "description": "这一镜用到的用户图片编号（input/images/index.json）"}
      }}},
    "unused_images": {"type": "array", "maxItems": 8, "description": "实在不合适用的用户图片和原因（给用户的总结里也要说明）",
      "items": {"type": "object", "required": ["id", "reason"], "additionalProperties": false,
        "properties": {"id": {"type": "string", "pattern": "^i[0-9]{2}$"}, "reason": {"type": "string", "maxLength": 200}}}}
  }
}
