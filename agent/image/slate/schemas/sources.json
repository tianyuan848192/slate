{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "联网搜索和引用来源",
  "type": "object",
  "required": ["queries", "sources"],
  "additionalProperties": false,
  "properties": {
    "queries": {"type": "array", "items": {"type": "string", "maxLength": 120}, "maxItems": 20},
    "sources": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "required": ["title", "url"], "additionalProperties": false,
      "properties": {"title": {"type": "string", "maxLength": 200}, "url": {"type": "string", "maxLength": 500},
                     "note": {"type": "string", "maxLength": 200}, "used": {"type": "boolean"}}}}
  }
}
