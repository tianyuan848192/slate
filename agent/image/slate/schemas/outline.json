{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "长片总纲：章节、完整讲稿、统一的视觉规范（各章会话按它并行制作）",
  "type": "object",
  "required": ["title", "look", "chapters"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "maxLength": 40},
    "look": {
      "type": "object", "required": ["skill", "palette", "fonts", "recurring", "transitions"], "additionalProperties": false,
      "description": "全片统一的视觉规范，每章都照着做",
      "properties": {
        "skill": {"type": "string", "maxLength": 40, "description": "全片用的风格 Skill"},
        "palette": {"type": "string", "maxLength": 300, "description": "配色：底色、主色、强调色及用法"},
        "fonts": {"type": "string", "maxLength": 300},
        "recurring": {"type": "string", "maxLength": 600, "description": "反复出现的元素：章节标题卡、角标、图表样式、共用组件在 shared/ 下的文件"},
        "transitions": {"type": "string", "maxLength": 300, "description": "章与章、镜与镜之间怎么衔接"},
        "notes": {"type": "string", "maxLength": 1000},
        "caption_style": {"type": "object", "additionalProperties": false, "description": "全片统一的字幕样式，各章分镜照抄",
          "properties": {"bg": {"type": "string", "maxLength": 60}, "color": {"type": "string", "maxLength": 60},
                         "font": {"type": "string", "maxLength": 160}, "weight": {"type": ["string", "number"]}}}
      }
    },
    "voice": {"type": "string", "maxLength": 40},
    "chapters": {
      "type": "array", "minItems": 2, "maxItems": 60,
      "items": {
        "type": "object", "required": ["id", "title", "duration", "summary", "narration"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]{2}$"},
          "title": {"type": "string", "maxLength": 20},
          "duration": {"type": "number", "minimum": 20, "maximum": 600},
          "summary": {"type": "string", "maxLength": 300, "description": "这一章讲什么、在全片里起什么作用"},
          "narration": {"type": "string", "maxLength": 6000, "description": "这一章的完整旁白，各章会话照着分镜，不再改写"},
          "opening": {"type": "string", "maxLength": 200, "description": "开头怎么接上一章"},
          "closing": {"type": "string", "maxLength": 200, "description": "结尾怎么引出下一章"},
          "images": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^i[0-9]{2}$"},
            "description": "这一章要用的用户图片编号，各章会话照着安排进镜头"}
        }
      }
    }
  }
}
